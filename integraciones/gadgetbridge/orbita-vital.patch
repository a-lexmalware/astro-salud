+/*  Órbita Vital (astro-salud): envía el pulso en vivo de un reloj Xiaomi a
+    Supabase para el panel de salud de la tripulación.
+
+    This program is free software: you can redistribute it and/or modify
+    it under the terms of the GNU Affero General Public License as published
+    by the Free Software Foundation, either version 3 of the License, or
+    (at your option) any later version. */
+package nodomain.freeyourgadget.gadgetbridge.service.devices.xiaomi.services;
+
+import android.os.SystemClock;
+
+import androidx.annotation.NonNull;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.io.IOException;
+import java.util.concurrent.TimeUnit;
+
+import nodomain.freeyourgadget.gadgetbridge.BuildConfig;
+import okhttp3.Call;
+import okhttp3.Callback;
+import okhttp3.MediaType;
+import okhttp3.OkHttpClient;
+import okhttp3.Request;
+import okhttp3.RequestBody;
+import okhttp3.Response;
+
+/**
+ * Inserta una fila en la tabla {@code pulso_reloj} de Supabase con cada medición,
+ * como mucho una cada {@link #INTERVALO_MS}. La URL, la clave anon y el astronauta
+ * se fijan al compilar (propiedades astroSupabaseUrl, astroSupabaseKey y
+ * astroAstronautaId). Sin URL o sin acceso a internet no hace nada.
+ */
+public final class AstroSaludSender {
+    private static final Logger LOG = LoggerFactory.getLogger(AstroSaludSender.class);
+    private static final long INTERVALO_MS = 2000;
+    private static final MediaType JSON = MediaType.get("application/json");
+
+    private static final OkHttpClient CLIENTE = new OkHttpClient.Builder()
+            .callTimeout(5, TimeUnit.SECONDS)
+            .build();
+
+    private static long ultimoEnvio = 0;
+    private static boolean enVuelo = false;
+
+    private AstroSaludSender() {
+    }
+
+    public static boolean activo() {
+        return BuildConfig.INTERNET_ACCESS
+                && !BuildConfig.ASTRO_SUPABASE_URL.isEmpty()
+                && !BuildConfig.ASTRO_SUPABASE_KEY.isEmpty();
+    }
+
+    public static synchronized void enviar(final int fc) {
+        if (!activo() || fc <= 0) {
+            return;
+        }
+        final long ahora = SystemClock.elapsedRealtime();
+        // Sin solapar peticiones: si la red va lenta se omiten mediciones.
+        if (enVuelo || ahora - ultimoEnvio < INTERVALO_MS) {
+            return;
+        }
+        ultimoEnvio = ahora;
+        enVuelo = true;
+
+        final String cuerpo = "{\"astronauta_id\":\"" + BuildConfig.ASTRO_ASTRONAUTA_ID + "\",\"fc\":" + fc + "}";
+        final Request peticion = new Request.Builder()
+                .url(BuildConfig.ASTRO_SUPABASE_URL + "/rest/v1/pulso_reloj")
+                .header("apikey", BuildConfig.ASTRO_SUPABASE_KEY)
+                .header("Authorization", "Bearer " + BuildConfig.ASTRO_SUPABASE_KEY)
+                .header("Prefer", "return=minimal")
+                .post(RequestBody.create(cuerpo, JSON))
+                .build();
+
+        CLIENTE.newCall(peticion).enqueue(new Callback() {
+            @Override
+            public void onFailure(@NonNull final Call call, @NonNull final IOException e) {
+                LOG.warn("Órbita Vital: no se pudo enviar el pulso", e);
+                terminar();
+            }
+
+            @Override
+            public void onResponse(@NonNull final Call call, @NonNull final Response respuesta) {
+                if (!respuesta.isSuccessful()) {
+                    LOG.warn("Órbita Vital: Supabase respondió {}", respuesta.code());
+                }
+                respuesta.close();
+                terminar();
+            }
+        });
+    }
+
+    private static synchronized void terminar() {
+        enVuelo = false;
+    }
+}
